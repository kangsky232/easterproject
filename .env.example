# Docker Compose production template. Copy to .env and replace every REPLACE_* value.
MYSQL_DATABASE=smart_smoke
MYSQL_USER=smart_smoke_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

# At least 32 random bytes; do not reuse this sample text.
JWT_SECRET=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_SECRET

# Set false after creating the first administrator. If true, all three values below are required.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=security-admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD

# Comma-separated public origins, without a trailing slash.
CORS_ALLOWED_ORIGINS=https://smoke.example.com
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088

# Huawei Cloud IoTDA MQTT data forwarding (规则引擎 -> MQTT 转发).
# Credentials come from IoTDA console -> 接入信息; do not commit real values.
# MQTT_INSTANCE_ID is optional unless the selected IoTDA MQTT instance requires it.
# MQTT_TOPIC must exactly match the rule-engine forwarding topic.
MQTT_ENABLED=false
MQTT_BROKER=ssl://85d896cdd1.st1.iotda-app.cn-north-4.myhuaweicloud.com:8883
MQTT_ACCESS_KEY=
MQTT_ACCESS_CODE=
MQTT_INSTANCE_ID=
MQTT_TOPIC=smoke/report

# Ollama runs on the Docker host and routes requests to its installed cloud model.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_TOKENS=768
OLLAMA_KEEP_ALIVE=10m
RAG_TIMEOUT_SECONDS=130
RAG_HEALTH_TIMEOUT_SECONDS=2
