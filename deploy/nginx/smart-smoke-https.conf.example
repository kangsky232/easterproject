# Place this file on the host reverse proxy after replacing the domain and certificate paths.
# Docker Compose publishes the application frontend only on 127.0.0.1:8088 or another private host port.
server {
    listen 80;
    server_name smoke.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name smoke.example.com;

    ssl_certificate /etc/letsencrypt/live/smoke.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/smoke.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
